@@ -0,0 +1,133 @@
+package docker
+
+import (
+	"archive/tar"
+	"bytes"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestArchiveTagsFromModernManifest(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "image.tar")
+	f, err := os.Create(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	tw := tar.NewWriter(f)
+	entries := []struct{ name, body string }{
+		{"index.json", `{"schemaVersion":2}`},
+		{"oci-layout", `{"imageLayoutVersion":"1.0.0"}`},
+		{"manifest.json", `[{"RepoTags":["example-amd64:tag","example-amd64:tag"],"Config":"blobs/config","Layers":["blobs/layer"]}]`},
+		{"blobs/config", `{"architecture":"amd64","os":"linux"}`},
+		{"blobs/layer", "layer contents"},
+	}
+	for _, entry := range entries {
+		if err := tw.WriteHeader(&tar.Header{Name: entry.name, Size: int64(len(entry.body)), Mode: 0600}); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := io.WriteString(tw, entry.body); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := tw.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := f.Close(); err != nil {
+		t.Fatal(err)
+	}
+	tags, err := GetArchiveTags(path)
+	if err != nil || !reflect.DeepEqual(tags, []string{"example-amd64:tag"}) {
+		t.Fatalf("tags=%v error=%v", tags, err)
+	}
+	input, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer input.Close()
+	var output bytes.Buffer
+	if err := EditArchive(input, &output, func(s string) string { return strings.TrimSuffix(s, "-amd64") }, ""); err != nil {
+		t.Fatal(err)
+	}
+	tr := tar.NewReader(&output)
+	manifestFound, layerFound := false, false
+	for {
+		h, err := tr.Next()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		if h.Name == "index.json" || h.Name == "oci-layout" {
+			t.Fatalf("stale OCI descriptor retained: %s", h.Name)
+		}
+		b, err := io.ReadAll(tr)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if h.Name == "manifest.json" {
+			var manifest []metadataEntry
+			if err := json.Unmarshal(b, &manifest); err != nil {
+				t.Fatal(err)
+			}
+			if manifest[0].RepoTags[0] != "example:tag" {
+				t.Fatal(manifest)
+			}
+			manifestFound = true
+		}
+		if h.Name == "blobs/layer" {
+			if string(b) != "layer contents" {
+				t.Fatal("layer payload changed")
+			}
+			layerFound = true
+		}
+	}
+	if !manifestFound || !layerFound {
+		t.Fatal("manifest or layer lost")
+	}
+}
+
+func TestActualKubernetesDocker29Archives(t *testing.T) {
+	directory := os.Getenv("SIEVE_KUBERNETES_IMAGE_ARCHIVES")
+	if directory == "" {
+		t.Skip("no built Kubernetes archive directory provided")
+	}
+	paths, err := filepath.Glob(filepath.Join(directory, "*.tar"))
+	if err != nil || len(paths) != 4 {
+		t.Fatalf("archives=%v error=%v", paths, err)
+	}
+	for _, path := range paths {
+		t.Run(filepath.Base(path), func(t *testing.T) {
+			tags, err := GetArchiveTags(path)
+			if err != nil || len(tags) != 1 {
+				t.Fatalf("tags=%v error=%v", tags, err)
+			}
+			input, err := os.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer input.Close()
+			edited := filepath.Join(t.TempDir(), "edited.tar")
+			output, err := os.Create(edited)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := EditArchive(input, output, func(s string) string { return strings.TrimSuffix(s, "-amd64") }, ""); err != nil {
+				t.Fatal(err)
+			}
+			if err := output.Close(); err != nil {
+				t.Fatal(err)
+			}
+			actual, err := GetArchiveTags(edited)
+			expected := strings.Replace(tags[0], "-amd64:", ":", 1)
+			if err != nil || !reflect.DeepEqual(actual, []string{expected}) {
+				t.Fatalf("edited=%v want=%s error=%v", actual, expected, err)
+			}
+		})
+	}
+}
