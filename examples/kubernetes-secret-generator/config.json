{
    "name": "kubernetes-secret-generator",
    "github_link": "https://github.com/mittwald/kubernetes-secret-generator.git",
    "commit": "f7e44605aa7980c305f0e600de1613e3c0e57efd",
    "kubernetes_version": "v1.24.10",
    "client_go_version": "v0.0.0-20191016111102-bec269661e48",
    "dockerfile_path": "build/Dockerfile",
    "controller_image_name": "kubernetes-secret-generator:latest",
    "test_command": "python3 examples/kubernetes-secret-generator/test/test.py",
    "custom_resource_definitions": ["stringsecret", "sshkeypair", "basicauth"],
    "annotated_reconcile_functions": {
        "pkg/controller/crd/stringsecret/stringsecret_controller.go": "github.com/mittwald/kubernetes-secret-generator/pkg/controller/crd/stringsecret.(*ReconcileStringSecret).Reconcile",
        "pkg/controller/secret/secret_controller.go": "github.com/mittwald/kubernetes-secret-generator/pkg/controller/secret.(*ReconcileSecret).Reconcile"
    },
    "controller_pod_label": "kubernetes-secret-generator",
    "container_name": "manager",
    "controller_deployment_file_path": "examples/kubernetes-secret-generator/deploy/operator.yaml",
    "test_setting": {
        "create-update-recreate": {"num_workers": 0}
    }
}
